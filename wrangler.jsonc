{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "safary",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-15",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/realtime/*"]
  },
  "vars": {
    "SUPABASE_URL": "https://tzznkrxnwbadgwsvlsle.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_-FjX828dyVXfm94U1vWG7g_UVHeXyyv"
  },
  "durable_objects": {
    "bindings": [
      { "name": "CHAT_ROOMS", "class_name": "ChatRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1-chat-rooms", "new_sqlite_classes": ["ChatRoom"] }
  ]
}